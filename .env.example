# =====================================================================
# Wire Desk — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# Precedence: CLI flags > Environment variables > .env file > JSON/TOML > Safe defaults
# =====================================================================

# --- Runtime environment ------------------------------------------------
# development | test | production
WIREDESK_ENV=development

# Bind address for the Axum HTTP server.
WIREDESK_HOST=0.0.0.0
WIREDESK_PORT=8080

# --- Paths (cross-platform, resolved via PathBuf / path.join) -----------
WIREDESK_DATA_DIR=./data
WIREDESK_DB_PATH=./data/wire-desk.db
WIREDESK_LOG_DIR=./logs
WIREDESK_BACKUP_DIR=./backups
WIREDESK_SCOPE_FILE=./data/scope.allowlist.json
WIREDESK_CONFIG_FILE=./data/config.json
WIREDESK_TMP_DIR=./tmp

# --- Logging / telemetry ------------------------------------------------
WIREDESK_LOG_LEVEL=info
WIREDESK_LOG_FORMAT=json   # json | plain
WIREDESK_REQUEST_ID_HEADER=X-Request-Id

# --- SQLite pragmas (applied on every connection) -----------------------
WIREDESK_DB_JOURNAL_MODE=WAL
WIREDESK_DB_SYNCHRONOUS=NORMAL
WIREDESK_DB_BUSY_TIMEOUT_MS=5000
WIREDESK_DB_FOREIGN_KEYS=ON
WIREDESK_DB_TEMP_STORE=MEMORY

# --- Security / crypto (REQUIRED in production — fail fast if weak) -----
# Generate: openssl rand -base64 32
WIREDESK_JWT_SECRET=change-me-in-production-min-32-chars
# HMAC signing key for outbound/inbound webhooks.
WIREDESK_WEBHOOK_SECRET=change-me-in-production-min-32-chars
# Argon2id is used internally for password hashing (no config needed).

# --- Multi-tenancy / CORS -----------------------------------------------
# Comma-separated allowed origins for CORS. Safe default for local dev.
WIREDESK_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
WIREDESK_PUBLIC_GRADER_ENABLED=true
WIREDESK_PUBLIC_GRADER_RATE_LIMIT_RPS=2

# --- LLM providers (read strictly from env; never commit keys) ----------
# At least one provider key recommended; offline mock mode used when unset.
WIREDESK_OPENROUTER_API_KEY=
WIREDESK_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
WIREDESK_NVIDIA_NIM_API_KEY=
WIREDESK_NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
WIREDESK_GEMINI_API_KEY=
WIREDESK_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
WIREDESK_DEEPSEEK_API_KEY=
WIREDESK_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Default model per task class (task-aware routing).
WIREDESK_MODEL_FAST=deepseek-chat
WIREDESK_MODEL_STRONG=openrouter/auto
WIREDESK_OFFLINE_MOCK=true

# LLM timeouts / resilience.
WIREDESK_LLM_CONNECT_TIMEOUT_MS=5000
WIREDESK_LLM_READ_TIMEOUT_MS=30000
WIREDESK_LLM_MAX_RETRIES=3
WIREDESK_LLM_CONCURRENCY=4

# --- Agent / queue limits (bounded, low-RAM) -----------------------------
WIREDESK_AGENT_MAX_ITERATIONS=10
WIREDESK_AGENT_TOOL_OUTPUT_CAP_CHARS=8000
WIREDESK_JOB_MAX_PENDING_PER_TENANT=100
WIREDESK_JOB_MAX_PENDING_GLOBAL=1000
WIREDESK_JOB_LEASE_TTL_SECONDS=300
WIREDESK_JOB_STALE_REAP_INTERVAL_SECONDS=60
WIREDESK_WORKER_CONCURRENCY=4
WIREDESK_SSE_BUFFER_MAX_EVENTS=500

# --- Cache bounds (bounded LRU with TTL) --------------------------------
WIREDESK_CACHE_MAX_CAPACITY=1024
WIREDESK_CACHE_TTL_SECONDS=300

# --- Stripe billing -----------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
WIREDESK_STRIPE_SUCCESS_URL=http://localhost:8080/billing/success
WIREDESK_STRIPE_CANCEL_URL=http://localhost:8080/billing/cancel
WIREDESK_BILLING_ENFORCEMENT=true

# --- E2B sandbox (optional; safe local fallback when unset) -------------
E2B_API_KEY=
E2B_TEMPLATE_ID=

# --- Referral / onboarding ----------------------------------------------
WIREDESK_REFERRAL_CODE=
WIREDESK_ONBOARDING_ENABLED=true

# --- Feature flags (runtime toggles) ------------------------------------
WIREDESK_FEATURE_EXPERIMENTAL_AGENTS=false
WIREDESK_FEATURE_SECURITY_SCANNERS=true
WIREDESK_FEATURE_PUBLIC_ROUTES=true
WIREDESK_FEATURE_BILLING_ENFORCEMENT=true

# --- Safe-harbor / legal ------------------------------------------------
WIREDESK_AUTHORIZED_USE_ACKNOWLEDGED=false
WIREDESK_SCOPE_STRICT_MODE=true
