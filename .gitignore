# =====================================================================
# Wire Desk — gitignore
# Never commit secrets, credentials, or local state.
# =====================================================================

# Environment / secrets
.env
.env.*
!.env.example
.env.bak

# Rust
target/
**/target/
debug/
*.pdb
**/*.rs.bk
rustc-ice-*.txt
**/mutants.out*/

# TypeScript / Node
node_modules/
.pnpm-store/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SQLite / database
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local state / runtime artifacts
data/*.db
data/*.json
logs/
backups/
tmp/
data/scope.allowlist.json
data/config.json

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Wire Desk specific
*.wire-desk-backup
*.bundle

# End
